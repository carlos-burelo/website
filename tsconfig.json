{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#components/*": [
        "src/core/components/*",
      ],
      "#constants/*": [
        "src/core/constants/*",
      ],
      "#content/*": [
        "src/content/*",
      ],
      "#libs/*": [
        "src/core/libs/*",
      ],
    }
  }
}