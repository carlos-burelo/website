---
const { title, summary, date, role, current } = Astro.props;
---

<li class="list-none relative pl-10 pb-10 last:pb-0">
    <!-- vertical line (hidden on last item via parent li) -->
    <span class="line absolute left-2.75 top-6 bottom-0 w-px bg-border" aria-hidden="true"></span>

    <!-- dot -->
    <span class={`absolute left-0 top-1.5 w-6 h-6 rounded-full border-2 flex items-center justify-center ${current ? 'border-primary bg-primary/15' : 'border-border bg-bg-secondary'}`}>
        <span class={`w-2 h-2 rounded-full ${current ? 'bg-primary animate-pulse' : 'bg-fg-paragraph/40'}`}></span>
    </span>

    <div class="card flex flex-col gap-2 p-4">
        <div class="flex items-start justify-between gap-4 flex-wrap">
            <h3 class="text-fg-titles font-semibold leading-tight">{title}</h3>
            <time class="text-xs text-fg-paragraph bg-bg px-2.5 py-1 rounded-full border border-border shrink-0 whitespace-nowrap">{date}</time>
        </div>
        <span class="text-sm font-medium text-primary">{role}</span>
        <p class="text-sm text-fg-paragraph leading-relaxed">{summary}</p>
    </div>
</li>
