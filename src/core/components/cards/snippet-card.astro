---
import Icon from "#components/elements/icon.astro";
import { toSlug } from "#libs/providers";

type Props = Pick<Snippet, "data" | "id">;

const { data, id } = Astro.props;
const slug = toSlug(id);
---

<a href={`/snippets/${slug}`} class="card block p-4 min-h-25 relative overflow-hidden">
    <i class="lang-icon absolute top-2 right-2 text-5xl z-0 not-italic opacity-70" data-lang={data.lang.toLowerCase()} aria-hidden="true">
        <Icon name={data.lang.toLowerCase()} />
    </i>
    <h4 class="z-10 relative text-fg-titles">{data.title}</h4>
</a>
