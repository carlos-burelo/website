---
import ProjectPlaceholder from "#components/elements/project-placeholder.astro";

export interface Props {
    title: string;
    description: string;
    preview: string;
    repository: string;
    tags: string[];
    stack: Record<string, number>;
    colClass?: string;
}

const { title, description, preview, repository, tags, stack, colClass = '' } = Astro.props;
---

<div class={`card group relative flex flex-col overflow-hidden min-h-64 ${colClass}`}>
    <!-- full-bleed placeholder -->
    <div class="absolute inset-0">
        <ProjectPlaceholder title={title} stack={stack} />
    </div>

    <!-- bottom overlay -->
    <div class="absolute inset-x-0 bottom-0 flex flex-col gap-2 p-4 bg-linear-to-t from-black/80 via-black/50 to-transparent">
        <div class="flex flex-col gap-0.5">
            <h3 class="text-white font-semibold group-hover:text-primary transition-colors leading-tight">{title}</h3>
            <p class="text-white/70 text-xs leading-relaxed line-clamp-2">{description}</p>
        </div>
        <div class="flex items-center justify-between">
            <div class="flex flex-wrap gap-1">
                {tags.slice(0, 3).map((tag: string) => (
                    <span class="text-[0.6em] px-1.5 py-0.5 rounded-md border border-white/20 text-white/60 uppercase tracking-wide bg-white/5">
                        {tag}
                    </span>
                ))}
            </div>
            <div class="flex gap-3 shrink-0">
                <a href={preview} target="_blank" rel="noopener noreferrer" class="text-xs text-white/60 hover:text-primary transition-colors">↗ Preview</a>
                <a href={repository} target="_blank" rel="noopener noreferrer" class="text-xs text-white/60 hover:text-primary transition-colors">↗ GitHub</a>
            </div>
        </div>
    </div>
</div>
