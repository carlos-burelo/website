---
import { Image } from "astro:assets";
import SectionHead from "@/core/components/elements/section-head.astro";
import foto1 from "@/assets/foto-1.avif";
import foto2 from "@/assets/foto-2.avif";
import foto3 from "@/assets/foto-3.avif";
---

<section>
    <SectionHead title="Fuera del trabajo" />

    <div class="grid gap-4 xs:grid-cols-2 md:grid-cols-12">
        <!-- foto grande izquierda -->
        <figure class="md:col-span-7">
            <div class="overflow-hidden rounded-lg border border-border">
                <Image
                    src={foto1}
                    alt="Carlos Burelo en pleno salto desde una pared curva naranja, con palmeras y arbustos detrás"
                    width={500}
                    height={700}
                    loading="lazy"
                    decoding="async"
                    quality={85}
                    format="avif"
                    class="w-full h-full object-cover"
                />
            </div>
        </figure>

        <!-- columna derecha: dos fotos -->
        <div class="grid gap-4 xs:col-span-2 md:col-span-5">
            <figure>
                <div class="overflow-hidden rounded-lg border border-border aspect-4/3">
                    <Image
                        src={foto2}
                        alt="Un gatito siamés jugando con un cachorro de Golden Retriever dentro de una silla acapulco amarilla, tomada desde arriba"
                        width={500}
                        height={300}
                        loading="lazy"
                        decoding="async"
                        quality={85}
                        format="avif"
                        class="w-full h-full object-cover"
                    />
                </div>
            </figure>

            <figure>
                <div class="overflow-hidden rounded-lg border border-border aspect-4/3">
                    <Image
                        src={foto3}
                        alt="Gata siamesa de ojos azules levantando la cabeza para mirar a la cámara"
                        width={500}
                        height={300}
                        loading="lazy"
                        decoding="async"
                        quality={85}
                        format="avif"
                        class="w-full h-full object-cover"
                    />
                </div>
            </figure>
        </div>
    </div>
</section>
