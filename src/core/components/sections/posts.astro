---
import PostCard from "#components/cards/post-card.astro";
import SectionHead from "#components/elements/section-head.astro";
import { getPosts } from "#libs/providers";

const posts = await getPosts();

const postByYears = Object.groupBy(posts, ({ props: { entry } }) =>
    entry.data.createdAt.getFullYear()
);

const years = Object.keys(postByYears).map(Number).sort((a, b) => b - a);
---

<section>
    <SectionHead
        level={1}
        title="Blog"
        description="Artículos sobre programación: JavaScript, estructuras de datos, redes, arquitectura y diseño de lenguajes."
    />
    <div class="reveal flex flex-col gap-12">
        {years.map((year) => (
            <div>
                <h2>{year}</h2>
                {postByYears[year]!.map(({ props: { entry } }) => (
                    <PostCard post={entry} />
                ))}
            </div>
        ))}
    </div>
</section>
