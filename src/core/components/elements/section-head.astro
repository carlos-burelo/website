---
export interface Props {
    title?: string;
    description?: string;
    level?: 1 | 2;
}

const { title, description, level = 2 } = Astro.props;
const Tag = level === 1 ? "h1" : "h2";
---

<div class="flex flex-col gap-2">
    {title && <Tag>{title}</Tag>}
    {description && <p class="text-sm max-w-[60ch]">{description}</p>}
</div>
