---
import Icon from "#components/elements/icon.astro";
import { Image } from "astro:assets";
import logo from "../../../../public/logo.svg";
---

<footer class="contain pt-12 pb-8 mt-16 border-t border-border">
    <div class="grid grid-cols-[1fr_auto] items-start gap-8 max-sm:grid-cols-1 mb-8">

        <!-- brand col -->
        <div class="flex flex-col gap-3">
            <div class="flex items-center gap-2">
                <Image src={logo} alt="Logo" width={32} height={32} class="w-8 h-8 object-contain" />
                <span class="font-semibold text-fg-titles">Carlos Burelo</span>
            </div>
            <p class="text-xs text-fg-paragraph max-w-xs leading-relaxed">
                Desarrollador web especializado en convertir ideas en software simple, claro y efectivo.
            </p>
        <div class="flex gap-3 mt-1">
                <a href="https://github.com/carlos-burelo" target="_blank" rel="noopener" aria-label="GitHub" class="glass text-fg-paragraph hover:text-primary transition-colors p-2 rounded-full">
                    <Icon name="github" />
                </a>
                <a href="https://linkedin.com/in/carlos-burelo" target="_blank" rel="noopener" aria-label="LinkedIn" class="glass text-fg-paragraph hover:text-primary transition-colors p-2 rounded-full">
                    <Icon name="linkedin" />
                </a>
            </div>
        </div>

        <!-- nav cols -->
        <div class="flex gap-12 max-sm:gap-8">
            <div class="flex flex-col gap-2">
                <span class="text-xs font-semibold uppercase tracking-widest text-fg-paragraph mb-1">Contenido</span>
                <a href="/blog" class="text-sm text-fg-links hover:text-primary transition-colors">Blog</a>
                <a href="/snippets" class="text-sm text-fg-links hover:text-primary transition-colors">Fragmentos</a>
                <a href="/resources" class="text-sm text-fg-links hover:text-primary transition-colors">Recursos</a>
            </div>
            <div class="flex flex-col gap-2">
                <span class="text-xs font-semibold uppercase tracking-widest text-fg-paragraph mb-1">Trabajo</span>
                <a href="/works" class="text-sm text-fg-links hover:text-primary transition-colors">Proyectos</a>
                <a href="mailto:carlosfernandoburelo@gmail.com" class="text-sm text-fg-links hover:text-primary transition-colors">Contacto</a>
            </div>
        </div>

    </div>

    <!-- bottom bar -->
    <div class="flex items-center justify-between pt-6 border-t border-border max-sm:flex-col max-sm:gap-2 max-sm:items-start">
        <span class="text-xs text-fg-paragraph">MIT {new Date().getFullYear()} — Carlos Burelo</span>
        <div class="flex items-center gap-4">
            <button
                id="theme-toggle"
                aria-label="Cambiar tema"
                class="glass flex items-center gap-1.5 text-xs text-fg-paragraph hover:text-primary transition-colors px-2.5 py-1 rounded-full"
            >
                <span id="theme-icon">☀️</span>
                <span id="theme-label">Modo claro</span>
            </button>
            <span class="text-xs text-fg-paragraph">Hecho con <a href="https://astro.build" target="_blank" rel="noopener" class="hover:text-primary transition-colors">Astro</a></span>
        </div>
    </div>
</footer>

<script>
    function initTheme() {
        const btn = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const label = document.getElementById('theme-label');
        if (!btn || !icon || !label) return;

        const isLight = () => document.documentElement.getAttribute('data-theme') === 'light';

        const update = () => {
            icon.textContent = isLight() ? '🌙' : '☀️';
            label.textContent = isLight() ? 'Modo oscuro' : 'Modo claro';
        };

        update();

        btn.addEventListener('click', () => {
            const next = isLight() ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            document.cookie = `theme=${next}; path=/; max-age=31536000; SameSite=Lax`;
            update();
        });
    }

    document.addEventListener('astro:page-load', initTheme);
</script>
