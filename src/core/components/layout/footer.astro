---
import Icon from "@/core/components/elements/icon.astro";

const YEAR = new Date().getFullYear();
---

<footer class="contain pt-16 pb-8 mt-24">
    <div class="h-px w-full bg-border" aria-hidden="true"></div>

    <div class="grid grid-cols-[1fr_auto] items-start gap-8 max-sm:grid-cols-1 my-10">

        <!-- brand col -->
        <div class="flex flex-col gap-3">
            <span class="display text-2xl">Carlos Burelo</span>
            <p class="text-sm text-fg-paragraph max-w-[38ch] leading-relaxed">
                Ingeniero de software. Software simple, claro y efectivo.
            </p>
        </div>

        <!-- nav cols -->
        <div class="flex gap-16 max-sm:gap-10">
            <div class="flex flex-col gap-2.5">
                <span class="display italic text-primary text-sm">Contenido</span>
                <a href="/blog" class="text-sm text-fg-links hover:text-primary transition-colors">Blog</a>
                <a href="/snippets" class="text-sm text-fg-links hover:text-primary transition-colors">Fragmentos</a>
                <a href="/stack" class="text-sm text-fg-links hover:text-primary transition-colors">Stack</a>
                <a href="/sobre-mi" class="text-sm text-fg-links hover:text-primary transition-colors">Sobre mí</a>
                <a href="/rss.xml" class="text-sm text-fg-links hover:text-primary transition-colors">RSS</a>
            </div>
            <div class="flex flex-col gap-2.5">
                <span class="display italic text-primary text-sm">Trabajo</span>
                <a href="/works" class="text-sm text-fg-links hover:text-primary transition-colors">Proyectos</a>
                <a href="mailto:carlosfernandoburelo@gmail.com" class="text-sm text-fg-links hover:text-primary transition-colors">Contacto</a>
                <a href="/cv.pdf" target="_blank" rel="noopener" class="text-sm text-fg-links hover:text-primary transition-colors">Currículum</a>
            </div>
        </div>

    </div>

    <!-- bottom bar -->
    <div class="flex items-center justify-between gap-4 flex-wrap pt-6 border-t border-border/60">
        <span class="text-xs text-fg-paragraph">© {YEAR} Carlos Burelo</span>
        <div class="flex items-center gap-5">
            <a href="https://github.com/carlos-burelo" target="_blank" rel="noopener" aria-label="GitHub" class="text-xs text-fg-paragraph hover:text-primary transition-colors">GitHub</a>
            <a href="https://linkedin.com/in/carlos-burelo" target="_blank" rel="noopener" aria-label="LinkedIn" class="text-xs text-fg-paragraph hover:text-primary transition-colors">LinkedIn</a>
            <button
                id="theme-toggle"
                aria-label="Cambiar tema"
                class="flex items-center gap-1.5 text-xs text-fg-paragraph hover:text-primary transition-colors cursor-pointer"
            >
                <span class="theme-sun" aria-hidden="true"><Icon name="sun" /></span>
                <span class="theme-moon" aria-hidden="true"><Icon name="moon" /></span>
                <span id="theme-label">Modo claro</span>
            </button>
        </div>
    </div>
</footer>

<style>
    .display {
        font-family: var(--font-family-display);
    }
</style>

<script>
    function initTheme() {
        const btn = document.getElementById('theme-toggle');
        const label = document.getElementById('theme-label');
        if (!btn || !label) return;

        const isLight = () => document.documentElement.getAttribute('data-theme') === 'light';

        const update = () => {
            label.textContent = isLight() ? 'Modo oscuro' : 'Modo claro';
        };

        update();

        btn.addEventListener('click', () => {
            const next = isLight() ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            document.cookie = `theme=${next}; path=/; max-age=31536000; SameSite=Lax`;
            update();
        });
    }

    document.addEventListener('astro:page-load', initTheme);
</script>
