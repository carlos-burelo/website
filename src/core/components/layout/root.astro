---
import Navbar from "@/core/components/layout/navbar.astro";
import { ClientRouter } from "astro:transitions";
import "../../theme/main.css";
import Fonts from "./fonts.astro";
import Footer from "./footer.astro";
import { SITE } from "@/core/constants/site";

export interface Props {
    title?: string;
    description?: string;
    navTitle?: string;
    type?: "website" | "article";
    publishedAt?: Date;
    updatedAt?: Date;
    noindex?: boolean;
    /** Ruta .md canónica de la página, para agentes. Añade <link alternate>. */
    markdown?: string;
}

const {
    title,
    description = SITE.description,
    navTitle,
    type = "website",
    publishedAt,
    updatedAt,
    noindex = false,
    markdown,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const isArticle = type === "article";

const jsonLd =
    isArticle && publishedAt
        ? {
              "@context": "https://schema.org",
              "@type": "BlogPosting",
              headline: title,
              description,
              datePublished: publishedAt.toISOString(),
              dateModified: (updatedAt ?? publishedAt).toISOString(),
              author: { "@type": "Person", name: SITE.author },
              mainEntityOfPage: canonical,
          }
        : {
              "@context": "https://schema.org",
              "@type": "WebSite",
              name: SITE.name,
              url: SITE.url,
          };
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex" />}
        {markdown && <link rel="alternate" type="text/markdown" href={new URL(markdown, SITE.url).href} />}
        <meta name="theme-color" content={SITE.themeColor} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta property="og:type" content={isArticle ? "article" : "website"} />
        <meta property="og:locale" content={SITE.locale} />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL("/og.png", SITE.url).href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={SITE.title} />
        <link rel="alternate" type="application/rss+xml" title={SITE.name} href={new URL("/rss.xml", SITE.url).href} />
        {isArticle && publishedAt && (
            <meta property="article:published_time" content={publishedAt.toISOString()} />
        )}
        {isArticle && updatedAt && (
            <meta property="article:modified_time" content={updatedAt.toISOString()} />
        )}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL("/og.png", SITE.url).href} />
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        <Fonts />
        <ClientRouter />
        <script is:inline>
            function applyTheme() {
                const theme = document.cookie.match(/theme=([^;]+)/)?.[1] ?? 'dark';
                document.documentElement.setAttribute('data-theme', theme);
            }
            applyTheme();
            document.addEventListener('astro:after-swap', applyTheme);
        </script>
    </head>
    <body>
        <Navbar navTitle={navTitle} />
        <div>
            <slot />
        </div>
        <Footer />
    </body>
</html>
