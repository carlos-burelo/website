---
import Root from "@/core/components/layout/root.astro";
---

<Root title="No encontrado" noindex={true}>
    <section class="flex flex-col items-center justify-center gap-4 min-h-[50dvh] text-center">
        <span class="display text-6xl font-medium">404</span>
        <p class="text-fg-paragraph text-sm max-w-xs">
            Esta página no existe o fue movida.
        </p>
        <a href="/" class="btn btn-primary">
            Volver al inicio
        </a>
    </section>
</Root>

<style>
    .display {
        font-family: var(--font-family-display);
    }
</style>
