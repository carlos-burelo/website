---
import Root from "@/core/components/layout/root.astro";
import Snippets from "@/core/components/sections/snippets.astro";
import { getSnippets } from "@/core/libs/providers";

const snippets = (await getSnippets()).map(({ props: { entry } }) => entry);
---

<Root
    title="Fragmentos"
    description="Fragmentos de código listos para copiar: CSS, JavaScript, Python, Rust y más."
>
    <Snippets snippets={snippets} />
</Root>
