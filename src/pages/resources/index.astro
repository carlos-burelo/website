---
import Root from "#components/layout/root.astro";
import SectionHead from "#components/elements/section-head.astro";
import Icon from "#components/elements/icon.astro";
import resources from "#content/resources.json";

const TYPE_ICONS: Record<string, string> = {
    tool:    "wrench",
    book:    "book",
    website: "globe",
    video:   "video",
    library: "package",
};

const grouped = Object.groupBy(resources, (r) => r.category);
const categories = Object.keys(grouped).sort();
---

<Root
    title="Recursos"
    description="Herramientas, libros, videos y referencias que uso o recomiendo."
>
    <section class="gap-12">
        <SectionHead
            level={1}
            title="Recursos"
            description="Herramientas, libros, videos y referencias que uso o recomiendo."
        />

        <div class="flex flex-col gap-10">
            {categories.map((category) => (
                <div class="flex flex-col gap-4">
                    <div class="flex items-center gap-4">
                        <h2 class="text-sm font-semibold uppercase tracking-widest text-fg-paragraph">{category}</h2>
                        <div class="flex-1 h-px bg-border"></div>
                        <span class="text-xs text-fg-paragraph">{grouped[category]!.length}</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1">
                        {grouped[category]!.map((resource) => (
                            <a
                                href={resource.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="card group flex items-start gap-3 p-4"
                            >
                                <span class="shrink-0 mt-0.5 text-fg-paragraph group-hover:text-primary transition-colors" aria-hidden="true"><Icon name={TYPE_ICONS[resource.type] ?? "link"} /></span>
                                <div class="flex flex-col gap-0.5 min-w-0">
                                    <span class="text-sm font-medium text-fg-titles group-hover:text-primary transition-colors leading-tight">{resource.title}</span>
                                    <span class="text-xs text-fg-paragraph leading-relaxed">{resource.description}</span>
                                </div>
                                <span class="ml-auto shrink-0 text-fg-paragraph group-hover:text-primary transition-colors text-xs mt-0.5" aria-hidden="true">↗</span>
                            </a>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </section>
</Root>
